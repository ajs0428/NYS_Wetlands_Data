# Ignore everything
* 

# Except 
!R_Code_Analysis/
!Python_Code_Analysis/
!Shell_Scripts/

# Don't ignore files directly in these directories
!Python_Code_Analysis/*
!R_Code_Analysis/*
# ignore scripts that start with X (gitignore has no trailing-comment syntax,
# so this must be on its own line to match)
R_Code_Analysis/X*.R
!Shell_Scripts/*.sh
Shell_Scripts/logs/

# Track models directory structure but not contents
!Models/
Models/*
!Models/.gitkeep

!.gitignore
!*.Rproj*
.Rproj.user
